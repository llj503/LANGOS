# 这些是要拷到 Linux 设备上跑的，**强制 LF**，别被 Windows 的 CRLF 污染
* text=auto eol=lf

# shell / 配置 / 源码一律 LF
*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.ini   text eol=lf
*.tsv   text eol=lf
*.md    text eol=lf

# 二进制原样，别转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.bmp   binary
*.gz    binary
*.tgz   binary
*.zip   binary
*.pkg   binary
*.exe   binary
vgfront binary
vgboot  binary
